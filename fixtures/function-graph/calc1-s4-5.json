{
  "preset": "function-graph",
  "title": "Resolução 4.5: tangentes horizontais",
  "x": { "range": [-1, 5], "unit": 86 },
  "y": { "range": [-2, 8], "unit": 40 },
  "functions": [
    {
      "id": "f",
      "expr": "x^3 - 6x^2 + 9x + 1",
      "label": { "text": "y = {expr}", "at": [4.2, 7], "towards": ["L", "D"] }
    }
  ],
  "lines": [
    { "id": "t1", "tangent": { "of": "f", "at": 1 }, "domain": [0.1, 1.9], "series": "tangentes" },
    { "id": "t2", "tangent": { "of": "f", "at": 3 }, "domain": [2.1, 3.9], "series": "tangentes" }
  ],
  "points": [
    { "id": "max", "at": { "of": "f", "x": 1 }, "label": "{coords}", "towards": ["U", "NE", "NW"] },
    { "id": "min", "at": { "of": "f", "x": 3 }, "label": "{coords}", "towards": ["D", "SE", "SW"] }
  ],
  "labels": [{ "text": "f′ = 0", "at": [1.9, 5.4], "towards": ["R", "U"], "names": "tangentes" }]
}

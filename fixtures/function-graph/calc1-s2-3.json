{
  "preset": "function-graph",
  "title": "Resolução 2.3: juros simples x compostos",
  "x": { "range": [-1, 6], "unit": 90, "name": "t" },
  "y": { "range": [-200, 2800], "unit": 0.15, "step": 200, "labelEvery": 2, "name": "R$" },
  "functions": [
    {
      "id": "S",
      "expr": "1000(1 + 0.2t)",
      "domain": [0, 5.6],
      "colour": "key",
      "legend": "juros simples: S(t) = {expr}",
      "label": { "text": "S", "at": 5.6, "towards": ["R", "D"], "size": 15 }
    },
    {
      "id": "C",
      "expr": "1000*1.2^t",
      "domain": [0, 5.6],
      "colour": "ask",
      "legend": "juros compostos: C(t) = 1000·(1,2)ᵗ",
      "label": { "text": "C", "at": 5.6, "towards": ["R", "U"], "size": 15 }
    }
  ],
  "points": [
    {
      "id": "S0",
      "at": { "of": "S", "x": 0 },
      "colour": "key",
      "label": "{y}",
      "towards": ["L", "NW"],
      "size": 12.5
    },
    {
      "id": "S2",
      "at": { "of": "S", "x": 2 },
      "colour": "key",
      "label": "{y}",
      "towards": ["SE", "D", "R"],
      "size": 12.5
    },
    {
      "id": "S4",
      "at": { "of": "S", "x": 4 },
      "colour": "key",
      "label": "{y}",
      "towards": ["SE", "D", "R"],
      "size": 12.5
    },
    {
      "id": "C2",
      "at": { "of": "C", "x": 2 },
      "colour": "ask",
      "label": "{y}",
      "towards": ["NW", "U", "L"],
      "size": 12.5
    },
    {
      "id": "C4",
      "at": { "of": "C", "x": 4 },
      "colour": "ask",
      "label": "{y:2}",
      "towards": ["NW", "U", "L"],
      "size": 12.5
    }
  ]
}

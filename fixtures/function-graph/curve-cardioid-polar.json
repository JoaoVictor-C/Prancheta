{
  "preset": "function-graph",
  "title": "A cardioide r = 1 + cos θ e a tangente em θ = π/2",
  "x": { "range": [-1, 3], "unit": 100 },
  "y": { "range": [-2, 2], "unit": 100 },
  "functions": [
    {
      "id": "c",
      "r": "1 + cos(θ)",
      "theta": [0, "2pi"],
      "label": { "text": "r = {expr}", "at": 0.6, "towards": ["NE", "R", "U"] }
    }
  ],
  "lines": [
    {
      "id": "t",
      "tangent": { "of": "c", "at": "pi/2" },
      "domain": [-1, 0.8],
      "colour": "ask",
      "style": "dashed",
      "label": { "text": "inclinação = {slope}", "at": -0.7, "towards": ["NW", "L", "U"] }
    }
  ],
  "points": [
    { "id": "P", "at": { "of": "c", "theta": "pi/2" }, "label": "P{coords}", "towards": ["NW", "NE", "L"] }
  ]
}

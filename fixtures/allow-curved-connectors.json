          {
            "id": "d",
            "type": "block",
            "x": 0,
            "y": 0,
            "width": 130,
            "height": 54,
            "label": "Emit",
            "fill": "#EAF0FF",
            "stroke": "#3966C9",
            "strokeWidth": 1.4,
            "radius": 6,
            "textAlign": "center",
            "verticalAlign": "center",
            "textColor": "#1B2A4A"
          }

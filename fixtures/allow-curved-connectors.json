                {
                  "x": 60,
                  "y": 250
                },
                {
                  "x": 300,
                  "y": 285
                }
              ]
            }
          }
        ]
      },
      {
        "type": "scene",
        "layout": "graph",
        "graph": {
          "algorithm": "layered",
          "direction": "RIGHT",
          "spacing": 46
        },
        "children": [
          {
            "id": "a",
            "type": "block",
            "x": 0,
            "y": 0,
            "width": 130,
            "height": 54,

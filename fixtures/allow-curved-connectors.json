{
  "version": 1,
  "title": "Curved connectors — needs allowCurvedConnectors",
  "canvas": {
    "padding": 26,
    "theme": "light",
    "constraints": {
      "allowCurvedConnectors": true
    }
  },
  "root": {
    "type": "stack",
    "direction": "column",
    "gap": 30,
    "align": "start",
    "children": [
      {
        "type": "scene",
        "layout": "absolute",
        "width": 620,
        "height": 300,
        "children": [
          {
            "id": "draft",
            "type": "block",
            "x": 30,
            "y": 30,
            "width": 130,
            "height": 54,
            "label": "Draft",
            "fill": "#EAF0FF",
            "stroke": "#3966C9",
            "strokeWidth": 1.4,
            "radius": 6,
            "textAlign": "center",
            "verticalAlign": "center",
            "textColor": "#1B2A4A"
          },
          {
            "id": "review",
            "type": "block",
            "x": 420,
            "y": 30,
            "width": 130,
            "height": 54,
            "label": "Review",
            "fill": "#EAF0FF",
            "stroke": "#3966C9",
            "strokeWidth": 1.4,
            "radius": 6,
            "textAlign": "center",
            "verticalAlign": "center",
            "textColor": "#1B2A4A"
          },
          {
            "id": "publish",
            "type": "block",
            "x": 420,
            "y": 210,
            "width": 130,
            "height": 54,
            "label": "Publish",
            "fill": "#EAF0FF",
            "stroke": "#3966C9",
            "strokeWidth": 1.4,
            "radius": 6,
            "textAlign": "center",
            "verticalAlign": "center",
            "textColor": "#1B2A4A"
          }
        ],
        "connectors": [
          {
            "id": "arc-over",
            "from": "draft",
            "to": "review",
            "arrow": "end",
            "curve": {
              "kind": "arc",
              "bulge": 0.18
            }
          },
          {
            "id": "arc-side",
            "from": "review",
            "to": "publish",
            "arrow": "end",
            "curve": {
              "kind": "arc",
              "bulge": 0.22
            }
          },
          {
            "id": "s-curve",

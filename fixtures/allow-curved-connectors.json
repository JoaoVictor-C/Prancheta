          },
          {
            "id": "sp2",
            "from": "b",
            "to": "d",
            "arrow": "end",
            "curve": {
              "kind": "spline"
            }
          },
          {
            "id": "sp3",
            "from": "a",
            "to": "c",
            "arrow": "end",
            "curve": {
              "kind": "spline"
            }
          },
          {
            "id": "sp4",
            "from": "c",
            "to": "d",
            "arrow": "end",
            "curve": {
              "kind": "spline"
            }
          }
        ]
      }
    ]
  }

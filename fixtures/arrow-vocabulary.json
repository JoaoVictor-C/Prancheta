{
  "version": 1,
  "title": "Arrowhead and line-style vocabulary",
  "canvas": { "padding": 32 },
  "root": {
    "type": "scene",
    "layout": "absolute",
    "width": 420,
    "height": 460,
    "children": [
      { "type": "block", "id": "closed-a", "x": 20, "y": 20, "width": 120, "height": 40, "label": "closed" },
      { "type": "block", "id": "closed-b", "x": 260, "y": 20, "width": 120, "height": 40, "label": "" },
      { "type": "block", "id": "open-a", "x": 20, "y": 80, "width": 120, "height": 40, "label": "open" },
      { "type": "block", "id": "open-b", "x": 260, "y": 80, "width": 120, "height": 40, "label": "" },
      { "type": "block", "id": "diamond-a", "x": 20, "y": 140, "width": 120, "height": 40, "label": "diamond" },
      { "type": "block", "id": "diamond-b", "x": 260, "y": 140, "width": 120, "height": 40, "label": "" },
      { "type": "block", "id": "circle-a", "x": 20, "y": 200, "width": 120, "height": 40, "label": "circle" },
      { "type": "block", "id": "circle-b", "x": 260, "y": 200, "width": 120, "height": 40, "label": "" },
      { "type": "block", "id": "crowsfoot-a", "x": 20, "y": 260, "width": 120, "height": 40, "label": "crowsfoot" },
      { "type": "block", "id": "crowsfoot-b", "x": 260, "y": 260, "width": 120, "height": 40, "label": "" },
      { "type": "block", "id": "half-a", "x": 20, "y": 320, "width": 120, "height": 40, "label": "half" },
      { "type": "block", "id": "half-b", "x": 260, "y": 320, "width": 120, "height": 40, "label": "" },
      { "type": "block", "id": "dotted-a", "x": 20, "y": 380, "width": 120, "height": 40, "label": "dotted" },

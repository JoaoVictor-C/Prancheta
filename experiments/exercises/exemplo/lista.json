                    "tangent": {
                      "of": "f",
                      "at": -1
                    },
                    "domain": [
                      -1.8,
                      -0.2
                    ],
                    "series": "tangentes",
                    "style": "dashed"
                  },
                  {
                    "id": "t2",
                    "tangent": {
                      "of": "f",
                      "at": 1
                    },
                    "domain": [
                      0.2,
                      1.8
                    ],
                    "series": "tangentes",
                    "style": "dashed"
                  }
                ],
                "points": [
                  {
                    "id": "M",

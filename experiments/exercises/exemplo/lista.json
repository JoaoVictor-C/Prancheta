                      "of": "f",
                      "x": -1
                    },
                    "label": "máx. {coords}",
                    "towards": [
                      "U",
                      "NW",
                      "NE"
                    ]
                  },
                  {
                    "id": "m",
                    "at": {
                      "of": "f",
                      "x": 1
                    },
                    "label": "mín. {coords}",
                    "towards": [
                      "D",
                      "SE",
                      "SW"
                    ]
                  }
                ],
                "labels": [
                  {
                    "text": "f′ = 0",
                    "at": [
                      1.8,
                      -2
                    ],
                    "towards": [
                      "R",
                      "U"
                    ],
                    "names": "tangentes"
                  }
                ]
              },
              "caption": "As tangentes horizontais em \\({{sol.M}}\\) e \\({{sol.m}}\\)."
            },
            {
              "spec": {
